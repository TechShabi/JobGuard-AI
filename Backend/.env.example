NODE_ENV=development
PORT=5000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=root
DB_PASSWORD=
JWT_SECRET=replace-with-long-random-string

# ── AI provider ──────────────────────────────────────────────────────────
# OpenAI is the default/primary AI provider (services/aiService.js). Only
# set AI_PROVIDER=gemini for a deliberate, temporary legacy rollback —
# anything else (including leaving it unset) always resolves to OpenAI.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Separate, independently-configurable model for Opportunity web-search
# discovery (web-search-capable models are a distinct, narrower set).
OPENAI_WEB_SEARCH_MODEL=gpt-4o-mini
OPENAI_WEB_SEARCH_ENABLED=true
# The Responses API tool name for hosted web search — kept configurable in
# case OpenAI renames/versions it (see config/openai.js).
OPENAI_WEB_SEARCH_TOOL_TYPE=web_search_preview
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=30000
OPENAI_WEB_SEARCH_TIMEOUT_MS=45000

# Legacy/deprecated — only read when AI_PROVIDER=gemini above. Not used by
# the default OpenAI runtime path.
GEMINI_API_KEY=

# ── Opportunity discovery providers ─────────────────────────────────────
# OpenAI web search (above) is the default/primary Opportunity discovery
# mechanism — worldwide, not tied to any one region's job-API dataset.
# Regional free/public job APIs (Jobicy, Himalayas, Remotive) are retained
# but OFF by default; set true to run them ADDITIONALLY alongside OpenAI
# web search, never as a replacement for it.
ENABLE_JOB_API_PROVIDERS=false
# Gemini Google Search grounding — legacy discovery path, requires a billed
# Gemini tier. Never the production default.
ENABLE_GEMINI_GROUNDED_DISCOVERY=false
# Dev/test-only escape hatch: allow development-sample opportunities to be
# shown even when NODE_ENV=production. Never set in real production — see
# services/opportunityDiscoveryService.js's production-honesty rule.
ALLOW_DEV_SAMPLE_OPPORTUNITIES=false

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
PAYMENT_PROVIDER=mock
# Zero-cost MVP default: false. No real payment gateway is required to run
# JobGuard. Paid plans are validated via /membership/interest (early-access
# requests) instead of checkout while this is false. Set to true only once
# a real PAYMENT_PROVIDER is wired up.
PAYMENTS_ENABLED=false
# Dev/test-only escape hatch to allow the mock payment adapter to run in a
# staging environment with NODE_ENV=production. Never set in real production.
ALLOW_MOCK_PAYMENTS=false
